# TubePilot AI Backend Configuration Example
# Copy this file to .env and provide your credentials when ready.
# TubePilot AI runs in graceful Demo/Development Mode when credentials are empty!

OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
YOUTUBE_API_KEY=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/api/auth/google/callback
APP_SECRET_KEY=tubepilot_secure_encryption_key_32bytes_sample!
DATABASE_URL=sqlite:///./tubepilot.db
FRONTEND_URL=http://localhost:5173
DEMO_MODE=true
