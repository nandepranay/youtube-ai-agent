# TubePilot AI Backend Configuration Example
# AI Provider Configuration (ollama | openai | demo)
AI_PROVIDER=ollama
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:7b

# OpenAI Configuration (Optional if using Ollama)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# YouTube Data API & Google OAuth
YOUTUBE_API_KEY=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/api/auth/google/callback

# Security & App
APP_SECRET_KEY=tubepilot_secure_encryption_key_32bytes_sample!
DATABASE_URL=sqlite:///./tubepilot.db
FRONTEND_URL=http://localhost:5173
DEMO_MODE=false
